//
// A bounded isotropic second-scatter approximation (m17.7c).  It is deliberately a small, finite
// stepping stone: m17.7d can consume it without changing the cache or the physical contract.
#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(rgba16f, set = 0, binding = 0) writeonly uniform image2D multiple_scattering_lut;
layout(set = 0, binding = 1) uniform sampler2D transmittance_lut;

layout(std140, set = 0, binding = 2) uniform AtmosphereParams {
    vec4 radii;             // planet radius, top height, Rayleigh height, Mie height (km)
    vec4 rayleigh_scattering;
    vec4 mie_scattering;
    vec4 mie_absorption;
    vec4 ground_albedo;
    vec4 solar_irradiance; // fixed unit-white input; never an authored scene sun
}
atmosphere;

void main() {
    const ivec2 size = imageSize(multiple_scattering_lut);
    const ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(px, size))) {
        return;
    }

    const vec2 uv = (vec2(px) + 0.5) / vec2(size);
    const vec4 transmittance = texture(transmittance_lut, uv);
    const vec3 direct = clamp(transmittance.rgb, vec3(0.0), vec3(1.0));
    const float sun_visible = clamp(transmittance.a, 0.0, 1.0);
    const vec3 scattering = max(atmosphere.rayleigh_scattering.rgb + atmosphere.mie_scattering.rgb,
                                vec3(0.0));
    const vec3 extinction = scattering + max(atmosphere.mie_absorption.rgb, vec3(0.0));
    const vec3 albedo = scattering / max(extinction, vec3(1e-6));

    // A full Hillaire multi-bounce solve is intentionally next work. This is its bounded isotropic
    // second-order term: atmospheric extinction removes unit-white direct light, then the single
    // scattering albedo survives the first AND the second scatter. `sun_visible` keeps a planet
    // occlusion (direct RGB=0 but no incident sunlight) from masquerading as atmospheric loss.
    // Every factor lives in [0,1], so the result is non-negative and at most 1/4 radiance.
    const vec3 first_scatter = sun_visible * (vec3(1.0) - direct);
    const vec3 ground_return = 0.5 + 0.5 * clamp(atmosphere.ground_albedo.rgb, vec3(0.0), vec3(1.0));
    const vec3 multiple = 0.25 * first_scatter * albedo * albedo * ground_return *
                          atmosphere.solar_irradiance.rgb;
    imageStore(multiple_scattering_lut, px, vec4(max(multiple, vec3(0.0)), 1.0));
}
