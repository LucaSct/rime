# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Rime gateway (same-origin web API and WebRTC sessions)
After=network.target

[Service]
Type=simple
User=rime
Group=rime
StateDirectory=rime
RuntimeDirectory=rime
ExecStart=/opt/rime/bin/rime-gateway --bind 127.0.0.1:8787 --catalogue /etc/rime/catalogue.conf --store /var/lib/rime/auth.log --rp-id rime.peekstar.eu --rp-origin https://rime.peekstar.eu --rp-name Rime --mail-relay 127.0.0.1:25 --mail-from rime@peekstar.eu --media-bind 10.77.0.22 --media-ports 50000-50002 --public-name rime.peekstar.eu --turn-uri turns:turn.rime.peekstar.eu:443?transport=tcp --turn-secret-file /etc/rime/turn-secret --trust-forwarded-from-loopback
Restart=on-failure

# Hardening
# service never needs setuid/setgid helpers
NoNewPrivileges=true
# /usr, /boot, /etc are read-only; only explicit paths are writable
ProtectSystem=strict
# no access to /home directories
ProtectHome=true
# isolated /tmp so secrets do not leak into shared temporary space
PrivateTmp=true
# only TCP/UDP/Unix sockets; no netlink or packet sockets
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# auth store and runtime/session sockets
ReadWritePaths=/var/lib/rime /run/rime
# GPU access, checked rather than assumed (m18/track-H-deploy-build): a hosted game is a CHILD of
# this unit's process, spawned inside the same cgroup/mount namespace, so hardening here applies to
# it too. None of the above hides /dev — ProtectSystem=strict exempts /dev, /proc and /sys, and there
# is deliberately no PrivateDevices= or DevicePolicy= here. RestrictAddressFamilies bounds socket()
# families, not device ioctls, so it does not touch the Vulkan/NVIDIA path either. On CT 122 the
# device nodes are 0666 root:root (measured), so `rime` needs no extra group membership to open them.

[Install]
WantedBy=multi-user.target
